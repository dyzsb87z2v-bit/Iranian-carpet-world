# Public site URL (used for links sent by the Telegram bot)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty to run in demo mode with sample data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram seller bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Chat id that receives "new listing to review" notifications (optional)
TELEGRAM_ADMIN_CHAT_ID=

# Claude API for listing extraction and translation (optional; bot works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Payments stay OFF until the Iran–EU trade and payment path is confirmed legal.
CHECKOUT_ENABLED=false
